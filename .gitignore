# local test-harness symlink to /tmp/node_modules
node_modules

# QA harness installs its tools ad hoc (see scripts/qa/README.md); a committed
# package.json would make Vercel try to npm-install on every deploy of this
# static site, so keep it local-only
package.json
package-lock.json

# QA screenshots are throwaway run output — look at them, don't commit them
scripts/qa/shot-*.png
shots/
# sweep-buttons writes its full click log here every run — same throwaway class
button-sweep-results.txt

# Travel-agencies working data is real company data — never commit it to this
# public repo. Build locally; deliver Excel snapshots via chat/Drive.
data/

# probes run from scripts/qa write their screenshots to a nested scripts/qa/scripts/qa/ —
# same throwaway class as shot-*.png above; the copies once committed there are untracked
scripts/qa/scripts/
