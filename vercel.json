      "destination": "https://www.directksab2b.com/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "direct-business-abdoulmagd911s-projects.vercel.app" }],
      "destination": "https://www.directksab2b.com/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/brand", "destination": "/brand/index.html" },
