  "settings": [
    {
      "key": "app.arabic_enabled",
      "group": "settings.app",
      "label": "setting.app.arabic_enabled",
      "schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "boolean" },
      "default": false,
      "effective_dated": false
    },
    {
      "key": "app.default_density",
      "group": "settings.app",
      "label": "setting.app.default_density",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": ["comfortable", "compact"]
      },
      "default": "comfortable",
      "effective_dated": false
    },
    {
      "key": "app.default_theme",
      "group": "settings.app",
      "label": "setting.app.default_theme",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": ["light", "dark", "colorful", "direct"]
      },
      "default": "direct",
      "effective_dated": false
    },
    {
      "key": "app.export_formats",
      "group": "settings.app",
      "label": "setting.app.export_formats",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "minItems": 1,
        "type": "array",
        "items": { "type": "string", "enum": ["csv", "xlsx"] }
      },
      "default": ["csv", "xlsx"],
      "effective_dated": false
    },
    {
      "key": "audit.recently_deleted_days",
      "group": "settings.app",
      "label": "setting.audit.recently_deleted_days",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 1,
        "maximum": 365
      },
      "default": 30,
      "effective_dated": false
    },
    {
      "key": "audit.undo_window_hours",
      "group": "settings.app",
      "label": "setting.audit.undo_window_hours",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 1,
        "maximum": 168
      },
      "default": 24,
      "effective_dated": false
    },
    {
      "key": "auth.device_idle_days",
      "group": "settings.org",
      "label": "setting.auth.device_idle_days",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 1,
        "maximum": 365
      },
      "default": 30,
      "effective_dated": false
    },
    {
      "key": "files.max_mb",
      "group": "settings.app",
      "label": "setting.files.max_mb",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "default": 20,
      "effective_dated": false
    },
    {
      "key": "notify.kinds_enabled",
      "group": "settings.app",
      "label": "setting.notify.kinds_enabled",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "assigned",
            "helper_added",
            "mentioned",
            "changed_by_other",
            "followed_change",
            "decision_needed",
            "report_issued",
            "report_for_review",
            "appraisal_step",
            "import_done",
            "alert_contract_expiring",
            "alert_kpi_behind",
            "alert_invoice_unpaid",
            "alert_kpi_checkin"
          ]
        }
      },
      "default": [
        "assigned",
        "helper_added",
        "mentioned",
        "changed_by_other",
        "followed_change",
        "decision_needed",
        "report_issued",
        "report_for_review",
        "appraisal_step",
        "import_done",
        "alert_contract_expiring",
        "alert_kpi_behind",
        "alert_invoice_unpaid",
        "alert_kpi_checkin"
      ],
      "effective_dated": false
    },
    {
      "key": "partner.id_format",
      "group": "settings.partners",
      "label": "setting.partner.id_format",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
          "width": { "type": "integer", "minimum": 3, "maximum": 8 }
        },
        "required": ["prefix", "width"],
        "additionalProperties": false
      },
      "default": { "prefix": "DK-P", "width": 4 },
      "effective_dated": false
    },
    {
      "key": "partner.name_stop_words",
      "group": "settings.partners",
      "label": "setting.partner.name_stop_words",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "default": ["شركة", "مؤسسة", "company", "co", "corp", "corporation", "ltd", "limited", "llc", "inc", "est"],
      "effective_dated": false
    },
    {
      "key": "partner.one_code_per_partner",
      "group": "settings.partners",
      "label": "setting.partner.one_code_per_partner",
      "schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "boolean" },
      "default": true,
      "effective_dated": false
    },
    {
      "key": "work.meeting_note_on_time_days",
      "group": "settings.work",
      "label": "setting.work.meeting_note_on_time_days",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 0,
        "maximum": 14
      },
      "default": 1,
      "effective_dated": true
    },
    {
      "key": "work.no_update_days",
      "group": "settings.work",
      "label": "setting.work.no_update_days",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      },
      "default": 7,
      "effective_dated": true
    },
    {
      "key": "work.pipeline_weekly_target",
      "group": "settings.work",
      "label": "setting.work.pipeline_weekly_target",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "default": 1,
      "effective_dated": true
    },
    {
      "key": "work.reminder_days_before_due",
      "group": "settings.work",
      "label": "setting.work.reminder_days_before_due",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "integer",
        "minimum": 0,
        "maximum": 30
      },
      "default": 1,
      "effective_dated": true
    },
    {
      "key": "work.week_starts_on",
      "group": "settings.work",
      "label": "setting.work.week_starts_on",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "string",
        "enum": ["saturday", "sunday", "monday"]
      },
      "default": "sunday",
      "effective_dated": true
    }
